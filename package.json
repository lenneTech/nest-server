{
  "name": "@lenne.tech/nest-server",
  "version": "12.0.0",
  "type": "module",
  "description": "Modern, fast, powerful Node.js web framework in TypeScript based on Nest with a GraphQL API and a connection to MongoDB (or other databases).",
  "keywords": [
    "node",
    "nest",
    "server",
    "mongodb",
    "graphql",
    "typescript"
  ],
  "author": "lenne.Tech <info@lenne.tech> (https://lenne.tech)",
  "homepage": "https://github.com/lenneTech/nest-server",
  "license": "MIT",
  "scripts": {
    "build": "rimraf dist && nest build && pnpm run build:copy-types && pnpm run build:copy-templates && pnpm run build:add-type-references && pnpm run build:framework-api",
    "build:add-type-references": "node scripts/add-type-references.cjs",
    "build:copy-templates": "node scripts/copy-build-assets.mjs templates",
    "build:copy-types": "node scripts/copy-build-assets.mjs types",
    "build:dev": "pnpm run build",
    "build:framework-api": "tsx scripts/generate-framework-api.ts",
    "build:pack": "pnpm pack && echo \"use file:/ROOT_PATH_TO_TGZ_FILE to integrate the package\"",
    "c": "pnpm run check",
    "cf": "pnpm run check:fix",
    "check": "node scripts/check.mjs",
    "check:consumer": "node scripts/check-consumer.mjs",
    "check:esm": "node scripts/check-esm-core.mjs",
    "check:fix": "pnpm install && pnpm run spectaql:sync && pnpm audit --fix && pnpm run check:overrides && pnpm peers check && pnpm run format && pnpm run lint:fix && pnpm run typecheck:tests && pnpm run typecheck:vendor && pnpm run check:esm && pnpm run check:swc-tdz && pnpm test && pnpm run build && pnpm run check:manifest && pnpm run check:server-start",
    "check:manifest": "node scripts/check-package-manifest.mjs",
    "check:mutations": "node scripts/check-mutations.mjs",
    "check:naf": "pnpm install && pnpm run spectaql:sync && pnpm run check:overrides && pnpm peers check && pnpm run format && pnpm run lint:fix && pnpm run typecheck:tests && pnpm run typecheck:vendor && pnpm run check:esm && pnpm run check:swc-tdz && pnpm test && pnpm run build && pnpm run check:manifest && pnpm run check:server-start",
    "check:overrides": "node scripts/check-overrides.mjs",
    "check:raw": "pnpm install --frozen-lockfile && pnpm run spectaql:sync && pnpm audit && pnpm run check:overrides && pnpm peers check && pnpm run format:check && pnpm run lint && pnpm run typecheck:tests && pnpm run typecheck:vendor && pnpm run check:esm && pnpm run check:swc-tdz && pnpm test && pnpm run build && pnpm run check:manifest && pnpm run check:server-start",
    "check:server-start": "cross-env NODE_ENV=local node scripts/check-server-start.mjs --entry=dist/main.js --port-env=NSC__PORT --ready=\"Server starte[dt] at\" --path=/",
    "check:swc-tdz": "nest build -b swc -p tsconfig.swc-tdz.json && node scripts/check-swc-tdz.mjs",
    "cnaf": "pnpm run check:naf",
    "docs": "pnpm run docs:ci && node scripts/open.mjs http://127.0.0.1:8080/ ./public/index.html && compodoc -p tsconfig.json -s",
    "docs:bootstrap": "node extras/update-spectaql-version.mjs && node scripts/run-spectaql.mjs",
    "docs:ci": "node -r ./src/core/modules/migrate/helpers/ts-compiler.js ./scripts/init-server.ts && pnpm run docs:bootstrap && compodoc -p tsconfig.json",
    "format": "oxfmt --write src/ scripts/",
    "format:check": "oxfmt --check src/ scripts/",
    "lint": "oxlint --type-aware --ignore-path .oxlintignore src/ tests/ scripts/",
    "lint:fix": "oxlint --type-aware --fix --ignore-path .oxlintignore src/ tests/ scripts/",
    "prepack": "pnpm run prestart:prod",
    "prepublishOnly": "pnpm run lint && pnpm run test:ci",
    "prestart:prod": "pnpm run build",
    "preversion": "pnpm run lint",
    "reinit": "rimraf pnpm-lock.yaml && rimraf node_modules && pnpm install && pnpm run lint && pnpm run test:e2e && pnpm run test:ci && pnpm run build",
    "reinit:clean": "rimraf pnpm-lock.yaml && rimraf node_modules && pnpm install && pnpm run test:e2e && pnpm run build",
    "reinit:legacy": "rimraf pnpm-lock.yaml && rimraf node_modules && pnpm install && pnpm run test:e2e",
    "spectaql:sync": "node extras/update-spectaql-version.mjs",
    "start": "pnpm run start:local",
    "start:debug": "nodemon --config nodemon-debug.json",
    "start:dev": "nodemon",
    "start:dev:swc": "nest start -b swc -w --type-check",
    "start:local": "cross-env NODE_ENV=local nodemon",
    "start:local:swc": "cross-env NODE_ENV=local nest start -b swc -w --type-check",
    "start:prod": "cross-env NODE_ENV=production node dist/main.js",
    "test": "pnpm run vitest:unit && pnpm run vitest",
    "test:ci": "pnpm run vitest:unit && pnpm run vitest:ci",
    "test:cleanup": "node scripts/clean-test-artifacts.mjs",
    "test:cov": "pnpm run vitest:unit:cov && pnpm run vitest:cov",
    "test:e2e": "pnpm run vitest",
    "test:infra": "node scripts/test-infra.mjs up",
    "test:infra:down": "node scripts/test-infra.mjs down",
    "test:infra:status": "node scripts/test-infra.mjs status",
    "test:types": "tsc --noEmit --skipLibCheck -p tests/types/tsconfig.json",
    "test:unit:watch": "vitest --config vitest.config.mts",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "typecheck:vendor": "node scripts/check-vendor-declarations.mjs",
    "vitest": "cross-env NODE_ENV=e2e vitest run --config vitest-e2e.config.mts",
    "vitest:ci": "cross-env NODE_ENV=ci vitest run --config vitest-e2e.config.mts",
    "vitest:cov": "cross-env NODE_ENV=e2e vitest run --coverage --config vitest-e2e.config.mts",
    "vitest:unit": "vitest run --config vitest.config.mts",
    "vitest:unit:cov": "vitest run --coverage --config vitest.config.mts",
    "vitest:watch": "cross-env NODE_ENV=e2e vitest --config vitest-e2e.config.mts",
    "watch": "nodemon --watch src --ext ts,ejs,json --exec \"pnpm run build:dev\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lenneTech/nest-server"
  },
  "bugs": {
    "url": "https://github.com/lenneTech/nest-server/issues"
