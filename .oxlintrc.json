{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn"],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn"
  },
  "env": {
    "browser": false,
    "node": true
  },
  "rules": {
    "eqeqeq": "warn",
    "no-console": ["warn", { "allow": ["warn", "error", "info", "debug", "trace", "time", "timeEnd", "group", "groupEnd"] }],
    "no-underscore-dangle": ["warn", {
      "allow": [
        "$__",
        "__args",
        "__schema",
        "_authenticatedViaBetterAuth",
        "_bsontype",
        "_configSubject$",
        "_doNotCheckSecurityDeep",
        "_endMigration",
        "_frozenConfigSubject$",
        "_id",
        "_instance",
        "_model",
        "_objectAlreadyCheckedForRestrictions",
        "_startMigration",
        "_translations",
        "_typeTestConfigs"
      ],
      "allowAfterThis": true,
      "allowAfterThisConstructor": true
    }],
    "no-unused-vars": ["warn", {
      "argsIgnorePattern": "^_",
      "caughtErrors": "none",
      "varsIgnorePattern": "^_"
    }],
    "no-unused-expressions": "off",
    "@typescript-eslint/no-unused-expressions": ["warn", {
      "allowShortCircuit": true,
      "allowTernary": true
    }],
    "no-extraneous-class": "off",
    "no-new": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-sort": "off",
    "import/no-unassigned-import": "off",
    "preserve-caught-error": "warn",

    // Type-aware rules (`oxlint --type-aware`, needs oxlint-tsgolint), as in NestJS 12's project template.
    // An un-awaited promise is the one defect here no other check sees: its rejection is unhandled, and Node ends
    // the process on that by default.
    "typescript/no-floating-promises": "error",
    // `--type-aware` also turns on every type-aware rule of the categories above. These are off because they cannot
    // work under `strict: false` (they answer "requires strictNullChecks" for every file) ...
    "typescript/no-unnecessary-boolean-literal-compare": "off",
    "typescript/no-useless-default-assignment": "off",
    // ... or because they flag this codebase's deliberate idioms rather than defects: `as` casts in a non-strict
    // codebase, `String(unknown)` and ids in log messages, exception bodies built by spreading, framework methods
    // passed by reference, role strings compared with RoleEnum members, `.sort()` on strings. Measured 2026-10-26:
    // ~3000 findings, none of them a defect. The rules that found real ones stay on.
    "typescript/consistent-return": "off",
    "typescript/no-base-to-string": "off",
    "typescript/no-misused-spread": "off",
    "typescript/no-redundant-type-constituents": "off",
    "typescript/no-unnecessary-template-expression": "off",
    "typescript/no-unnecessary-type-arguments": "off",
    "typescript/no-unnecessary-type-assertion": "off",
    "typescript/no-unnecessary-type-conversion": "off",
    "typescript/no-unnecessary-type-parameters": "off",
    "typescript/no-unsafe-enum-comparison": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/require-array-sort-compare": "off",
    "typescript/restrict-template-expressions": "off",
    "typescript/unbound-method": "off"
  },
  "overrides": [
    {
      "files": ["**/migrate/cli/**", "**/migrate/migration-runner.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["scripts/**"],
      "rules": {
        "eqeqeq": "off",
        "no-console": "off"
      }
    },
    {
      "files": ["tests/**", "**/*.spec.ts", "**/*.test.ts", "**/*.e2e-spec.ts"],
      "rules": {
        "no-unused-vars": "off"
      }
    },
    {
      "files": ["src/**"],
      "rules": {
        "unicorn/no-array-reverse": "off"
      }
    }
  ]
}
